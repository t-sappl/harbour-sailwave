# SPDX-License-Identifier: GPL-3.0-or-later
[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=harbour-sailwave-radio
Exec=harbour-sailwave-radio
Name=Sailwave
Name[de]=Sailwave
# App grid folders are named after common categories
Categories=AudioVideo;Audio;Player;
# Sailplay (wireless CarPlay / Android Auto, SDK v1): the car screen lists
# Sailwave as a music app with its favourites and station history
# (src/sailplaybridge.h). The service is the app's D-Bus name
# (OrganizationName.ApplicationName below).
X-Sailplay-ApiVersion=1
X-Sailplay-Service=harbour-sailwave.harbour-sailwave
X-Sailplay-ObjectPath=/org/sailplay/v1/App
X-Sailplay-Presentation=template
X-Sailplay-Capabilities=media;content;

[X-Sailjail]
# Deliberately still harbour-sailwave (the package name up to 1.0.1): the
# data folders ~/.local/share/<Org>/<App> and ~/.cache/<Org>/<App> follow
# these names, so favourites, histories and settings are kept after the
# rename to harbour-sailwave-radio. Never change without a data migration.
OrganizationName=harbour-sailwave
ApplicationName=harbour-sailwave
Permissions=Internet;Audio;Documents;Downloads;Secrets
# Sailplay: the car can start Sailwave over D-Bus (its name above)
ExecDBus=harbour-sailwave-radio
